# Zshrc
# Zsh configuration for interactive shells

# Related man pages
# - zshmodules : modules
# - zshparam   : parameters like HISTFILE
# - zshoptions : options
# - zshbuiltins: builtin commands like autoload
# - zshcompsys : completion system
# - zshcontrib : non-core autoloadable functions
# - zshzle     : zsh line editor (zle) and bindkey
# - zshexpn    : expansion and substitution

### Basic Configs

# Collect a profile to make it possible to investigate the startup speed of zshrc.
zmodload zsh/zprof

export LANG=en_US.UTF-8

bindkey -e # Like Emacs

# Remap <C-w> to <C-t> to use <C-w> for window switching in Vim terminal.
bindkey "^t" backward-kill-word

# Shorten long and frequently used paths.
hash -d github=$HOME/ghq/src/github.com

setopt hist_ignore_all_dups
setopt share_history
setopt auto_cd
setopt auto_pushd
setopt list_packed
setopt interactive_comments
unsetopt list_beep
unsetopt correct
unsetopt nomatch

### Completions

# Use completion with case-insensitivity.
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'

# (Only for macOS)
# Homebrew's git formula ships its own limited zsh `_git` completion, which
# shadows zsh's fuller one that the git alias completions below rely on.
# ref: https://github.com/Homebrew/homebrew-core/issues/13700, https://github.com/orgs/Homebrew/discussions/2797
[[ -L /opt/homebrew/share/zsh/site-functions/_git ]] && rm -f /opt/homebrew/share/zsh/site-functions/_git

# Docker
[[ -L $HOME/.docker/completions ]] && fpath=($HOME/.docker/completions $fpath)

autoload -Uz compinit
# Enable auto completion while refreshing the cache in .zcompdump only once in a day
# to keep the average startup time of Zsh faster.
() {
    # Get .zcompdump only if its last refhresh was more than 24 hours ago by glob qualifiers.
    # The `old` array becomes empty otherwise.
    local old=( ~/.zcompdump(mh+23N) )
    if (( $#old )); then
        echo 'compinit with refresh'
        compinit
    else
        compinit -C # Skip refresh
    fi
}

# Tell Zsh to use gits' completion for the `bin/g` wrapper function.
compdef g=git

# Give completion to git aliases that shell out to external commands (see `git alias`).
# Zsh's _git dispatches to a `_git-<subcommand>` function if one exists.
_git-si()  { _git-status "$@" }
_git-hi()  { _git-log "$@" }
_git-di()  { _git-diff "$@" }
_git-shi() { _git-show "$@" }
_git-bi()  { _git-branch "$@" }

### History

HISTFILE=~/.zsh_history
HISTSIZE=500000 # The max number of history events on memory
SAVEHIST=500000 # The max number of history events saved in $HISTFILE

autoload -Uz history-search-end
zle -N history-beginning-search-backward-end history-search-end
zle -N history-beginning-search-forward-end history-search-end
bindkey "^P" history-beginning-search-backward-end
bindkey "^N" history-beginning-search-forward-end

### Prompt

autoload -Uz vcs_info
autoload -Uz add-zsh-hook
zstyle ':vcs_info:*' formats '%F{green}%b%f %m'
zstyle ':vcs_info:*' actionformats '%F{green}%b%f %F{red}%a%f %m'

# A prompt like:
#     ~/.dotfiles main =
#     ❯
# inspired by https://github.com/sindresorhus/pure
_is_first_prompt=1
function _update_prompt() {
    local symbol_color=$([[ $? == 0 ]] && echo 'cyan' || echo 'magenta')
    if [[ $_is_first_prompt == 1 ]]; then
        _is_first_prompt=0
    else
        print ''
    fi
    LANG=en_US.UTF-8 vcs_info
    local ssh_info=$(test -z "$SSH_CLIENT" && echo '' || echo ' %F{yellow}(SSH)%f')
    # Use as a jump marker in tmux's copy-mode.
    local prompt_sequence=$'\033]133;A\033\\'
    PROMPT="$prompt_sequence%F{246}%~%f ${vcs_info_msg_0_}${ssh_info}
%F{$symbol_color}❯%f "
}
add-zsh-hook precmd _update_prompt

# VCS (Git) info display

# Show ahead/behind against the upstream branch in the prompt.
# The remote-tracking refs are refreshed asynchronously by _maybe_fetch_upstream,
# so this hook only reads local refs and never touches the network.
zstyle ':vcs_info:git*+set-message:*' hooks git-status
function +vi-git-status() {
    local ahead behind out
    ahead=$(git rev-list --count @{upstream}..HEAD 2>/dev/null) || return
    behind=$(git rev-list --count HEAD..@{upstream} 2>/dev/null)
    (( ahead ))  && out+="%F{yellow}↑${ahead}%f"
    (( behind )) && out+="%F{red}↓${behind}%f"
    # In sync with upstream (we got here, so an upstream exists).
    [[ -z $out ]] && out="%F{246}=%f"
    hook_com[misc]="${out}"
}

# Asynchronously refresh the current repo's remote-tracking refs, throttled by a
# stamp file inside .git. This lets the prompt show ahead/behind without ever
# blocking on the network, and adapts to whichever repo we are currently in.
_GIT_FETCH_INTERVAL=300 # seconds
function _maybe_fetch_upstream() {
    git rev-parse --is-inside-work-tree &>/dev/null || return
    # Skip when the current branch has no upstream to compare against.
    git rev-parse --abbrev-ref @{upstream} &>/dev/null || return

    local git_dir stamp
    git_dir=$(git rev-parse --git-dir) || return
    stamp="$git_dir/.zsh_fetch_stamp"

    # Bail out while the stamp is still fresh (mtime within the interval).
    # extended_glob is needed for the (#q...) form; local_options keeps it scoped.
    setopt local_options extended_glob
    local -a fresh=( $stamp(#qNms-$_GIT_FETCH_INTERVAL) )
    (( $#fresh )) && return
    touch "$stamp"

    # Detach fully so the prompt is never blocked by the fetch.
    ( git fetch --quiet --no-tags &>/dev/null & ) &>/dev/null
}
add-zsh-hook precmd _maybe_fetch_upstream

### Command Rewriting

# Custom accept-line widget for command rewriting.
function _custom_accept_line() {
    # Ignore complex lines for safety (pipes, semicolons, &&, ||).
    if [[ "$BUFFER" == *'|'* || "$BUFFER" == *';'* || "$BUFFER" == *'&&'* ]]; then
        zle .accept-line
        return
    fi

    ### Empty Enter
    # Show `ls` and `git status` on empty line.
    if [[ -z "$BUFFER" ]]; then
        if git rev-parse --is-inside-work-tree &>/dev/null; then
            echo
            git -c color.status=always status --short --branch
            echo
            git re
        else
            ls
        fi
        zle reset-prompt
        return
    fi

    ### Auto Help Formatter
    # Route `--help` and `-h` through the `help` command for colorized output.
    # e.g. "git status --help" is rewritten to "help git status".
    # You can avoid this auto conversion by adding an extra space to the end.
    # e.g. "git status --help " runs as is without being rewritten.
    if [[ "$BUFFER" == *' --help' ]]; then
        BUFFER="help ${BUFFER% --help}"
    elif [[ "$BUFFER" == *' -h' ]]; then
        BUFFER="help ${BUFFER% -h}"
    fi
    # Strip "help " prefix when a trailing comma is appended.
    # e.g. "help git," runs "git". Useful for recalling help history and running the command.
    if [[ "$BUFFER" == 'help '*, ]]; then
        BUFFER="${BUFFER#help }"
        BUFFER="${BUFFER%,}"
    fi

    zle .accept-line
}
zle -N accept-line _custom_accept_line

### Other setups

# Key remapping for non-terminal-emulator environment.
zkbd_file="$HOME/.zkbd/$TERM-${${DISPLAY:t}:-$VENDOR-$OSTYPE}"
if [ -f $zkbd_file ]; then
    # Load a dictionary of special keys for the current terminal.
    # You can build a directory interactively by running `autoload zkbd; zkbd`.
    source $zkbd_file
    # Remap navigation keys to ensure consistent behavior across applications (see dotfiles/xremap/README.md).
    # While these bindings are rarely used since they are remapped at the terminal emulator level,
    # they are still useful in terminals that doesn't remap keys like tty1.
    bindkey "${key[Home]}" beginning-of-line
    bindkey "${key[End]}" end-of-line
    bindkey "${key[Up]}" history-beginning-search-backward-end
    bindkey "${key[Down]}" history-beginning-search-forward-end
fi

source "$DOTPATH/dotfiles/shell/aliases"

source "$DOTPATH/dotfiles/fzf/config.sh"

# https://github.com/rhysd/hgrep
function hgrep() {
    command hgrep --term-width "$COLUMNS" "$@"
}

# https://github.com/direnv/direnv
if has direnv; then
    eval "$(direnv hook zsh)"
fi

# Load local settings.
[ -f ~/.zshrc.local ] && source ~/.zshrc.local

zprof > /tmp/zprof.txt
