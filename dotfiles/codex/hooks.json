{
  "description": "Personal Codex lifecycle hooks.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [{ "type": "command", "command": "_codex_hook.js" }]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [{ "type": "command", "command": "_codex_hook.js" }]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [{ "type": "command", "command": "_codex_hook.js" }]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [{ "type": "command", "command": "_codex_hook.js" }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "_codex_hook.js", "timeout": 30 }]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [{ "type": "command", "command": "_codex_hook.js", "timeout": 30 }]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [{ "type": "command", "command": "_codex_hook.js", "timeout": 3 }]
      }
    ]
  }
}
