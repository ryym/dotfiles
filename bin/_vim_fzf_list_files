#!/usr/bin/env bash

# A script called from Vim's fzf utility. See: ./dotfiles/vim/autoload/my/plug/fzf.vim

main() {
    cmd="$1"
    shift
    case "$cmd" in
        buffers) buffers "$@" ;;
        buffers_and_files) buffers_and_files "$@" ;;
        fd_formatted) fd_formatted "$@" ;;
        git_diff_files) git_diff_files "$@" ;;
        *)
            echo 'specify valid command'
            exit 1
    esac
}

# Format buffers passed as arguments.
buffers() {
    for filepath in "$@"; do
        format 33 ':' "$(basename "$filepath")" "$(dirname "$filepath")"
    done
}

# - list all files as well as currently open buffers in Vim
# - list buffers first and list other files excluding buffers
# Buffers are passed as arguments.
buffers_and_files() {
    excludes=('-e' '_')
    for filepath in "$@"; do
        format 33 ':' "$(basename "$filepath")" "$(dirname "$filepath")"
        excludes+=("-e" "$(format 0 '=' "$(basename "$filepath")" "$(dirname "$filepath")")")
    done
    fd --hidden -tf -tl -E .git -E .claude/worktrees --format "$(format 0 '=' '{/}' '{//}')" | grep -v -F -x "${excludes[@]}"
}

fd_formatted() {
    fd --hidden -tf -tl -E .git -E .claude/worktrees --format "$(format 0 '=' '{/}' '{//}')" "$@"
}

# List files with a diff against the given rev (defaults to HEAD), marking
# each file with its diff status (added/modified/deleted/renamed) in its own color.
# Untracked files (not yet `git add`ed) are included too, treated as added.
# Files currently open in Vim (passed as arguments after the rev) are highlighted
# and listed first.
git_diff_files() {
    rev="${1:-HEAD}"
    shift || true

    buf_lines=()
    other_lines=()
    while IFS=$'\t' read -r status f1 f2; do
        filepath="${f2:-$f1}"
        case "$status" in
            A*) mark='+'; mark_color=32 ;; # green: added
            D*) mark='-'; mark_color=31 ;; # red: deleted
            M*) mark='~'; mark_color=33 ;; # yellow: modified
            R*) mark='>'; mark_color=36 ;; # cyan: renamed
            C*) mark='c'; mark_color=36 ;; # cyan: copied
            *)  mark='?'; mark_color='38;5;245' ;;
        esac

        # Keep the order of the buffer arguments (most recently accessed first)
        # by placing each matched line at its buffer index.
        buf_idx=-1
        i=0
        for buffile in "$@"; do
            if [[ "$buffile" == "$filepath" || "$buffile" == "$PWD/$filepath" ]]; then
                buf_idx="$i"
                break
            fi
            i=$((i + 1))
        done

        if [[ "$buf_idx" -ge 0 ]]; then
            buf_lines[buf_idx]="$(format 33 "$mark" "$(basename "$filepath")" "$(dirname "$filepath")" "$mark_color")"
        else
            other_lines+=("$(format 0 "$mark" "$(basename "$filepath")" "$(dirname "$filepath")" "$mark_color")")
        fi
    done < <(
        git diff --name-status "$rev"
        git ls-files --others --exclude-standard | while IFS= read -r f; do
            printf 'A\t%s\n' "$f"
        done
    )

    [[ ${#buf_lines[@]} -gt 0 ]] && printf '%s\n' "${buf_lines[@]}"
    [[ ${#other_lines[@]} -gt 0 ]] && printf '%s\n' "${other_lines[@]}"
    return 0
}

format() {
    color="$1"
    mark="$2"
    base="$3"
    dir="$4"
    mark_color="${5:-38;5;245}"
    # e.g. format 33 ':' 'index.js' 'src/auth' => ": index.js src.auth/index.js" with nice coloring
    printf "[%sm%s[0m [%sm%s[0m [38;5;245m%s/[38;5;240m%s[0m\n" "$mark_color" "$mark" "$color" "$base" "$dir" "$base"
}

main "$@"
