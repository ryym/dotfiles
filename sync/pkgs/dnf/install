#!/usr/bin/env bash

set -eu
trap 'echo SYNC STOPPED: $0' ERR INT
source "$DOTPATH/sync/lib/utils.sh"

log_start 'dnf'

install() {
    run sudo dnf install -y "$@"
}

if is_dryrun || has dnf; then
    basic_packages=(
        # Basic development tools
        alacritty
        clang
        curl
        fzf
        ibus-mozc
        jq
        make
        neovim
        tmux
        zsh
        # Fonts
        intel-one-mono-fonts
    )
    install "${basic_packages[@]}"

    if ! has docker; then
        # Docker: https://docs.docker.com/engine/install/linux-postinstall/
        run sudo dnf config-manager addrepo --from-repofile https://download.docker.com/linux/fedora/docker-ce.repo
        docker_packages=(
            docker-ce
            docker-ce-cli
            containerd.io
            docker-buildx-plugin
            docker-compose-plugin
        )
        install "${docker_packages[@]}"
    fi

    # Required to build Ruby
    ruby_build_packages=(
        perl
        zlib-devel
        libffi-devel
        libyaml-devel
    )
    install "${ruby_build_packages[@]}"
else
    log_error 'dnf not found'
    exit 1
fi

log_finish 'dnf'
