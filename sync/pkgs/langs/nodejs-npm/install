#!/usr/bin/env bash

log_start 'npm install (global)'

install() {
    run npm install -g "$1"
}

if is_dryrun || has npm; then
    while IFS= read -r pkg; do
        case "$pkg" in
            ''|'#'*) continue ;;
        esac
        install "$pkg"
    done < "$DOTPATH/sync/pkgs/langs/nodejs-npm/packages"
else
    log_error 'npm is not available'
    exit 1
fi

log_finish 'npm install (global)'
