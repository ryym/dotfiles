#!/usr/bin/env bash

set -eu
trap 'echo SYNC STOPPED: $0' ERR INT
source "$DOTPATH/sync/lib/utils.sh"

log_start 'apt'

install() {
    run sudo apt-get install -y "$@"
}

if is_dryrun || has apt-get; then
    run sudo apt-get update

    basic_packages=(
        # Basic development tools
        clang
        curl
        fzf
        ibus-mozc
        jq
        make
        neovim
        tmux
        zsh
    )
    install "${basic_packages[@]}"

    # Required to build Ruby
    ruby_build_packages=(
        build-essential
        perl
        zlib1g-dev
        libffi-dev
        libyaml-dev
        libssl-dev
    )
    install "${ruby_build_packages[@]}"
else
    log_error 'apt-get not found'
    exit 1
fi

log_finish 'apt'
