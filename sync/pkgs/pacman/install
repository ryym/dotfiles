#!/usr/bin/env bash

set -eu
trap 'echo SYNC STOPPED: $0' ERR INT
source "$DOTPATH/sync/lib/utils.sh"

log_start 'pacman'

install() {
    run sudo pacman --noconfirm -S "$@"
}

mode="$1"

if is_dryrun || has pacman; then
    # Note that this needs interactive inputs.
    run sudo pacman -Syu

    packages=(
        # For building AUR packages
        base-devel
        # Basic development tools
        alacritty
        clang
        curl
        docker
        docker-buildx
        docker-compose
        foot
        fzf
        git
        go
        jq
        make
        man-db
        neovim
        sudo
        tailscale
        tmux
        tree
        which
        wl-clipboard
        zsh
        # For building Ruby 3.2 or later
        libyaml
        # Japanese input and Emoji
        ibus-anthy # ibus-mozc is in AUR
        noto-fonts-cjk
        noto-fonts-emoji
        # Fcitx5 is often instable compared to ibus.
        # fcitx5-im
        # fcitx5-mozc
        # Utilities
        iwd
        # For running AppImage (https://github.com/AppImage/AppImageKit/wiki/FUSE)
        fuse2
    )
    install "${packages[@]}"

    # Sway
    if [ "$mode" = "with=sway" ]; then
        sway_packages=(
            blueberry
            chromium
            firefox
            grim
            pamixer
            polkit-gnome
            pulseaudio-bluetooth
            rofi-wayland
            slurp
            sway
            swaybg
            swayimg
            wev
            wob
            xorg-xwayland
        )
        install "${sway_packages[@]}"
    fi

    # AUR
    # https://aur.archlinux.org/packages/slack-desktop
    # https://aur.archlinux.org/packages/gnome-browser-connector-git
else
    log_error 'pacman not found'
    exit 1
fi

log_finish 'pacman'
